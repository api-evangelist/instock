{
  "opencollection": "1.0.0",
  "info": {
    "name": "Instock API reference Articles Ordertasks API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ordertasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve ordertask",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.instock.com/v1/:site_id/ordertasks/:ordertask_id",
            "headers": [
              {
                "name": "Instock-Correlation-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "site_id",
                "value": "1.1.0-1",
                "type": "path",
                "description": "ID of Instock site. Globally unique."
              },
              {
                "name": "ordertask_id",
                "value": "ot0001",
                "type": "path",
                "description": "ID of an order task. Unique in scope of your organization(s)."
              }
            ]
          },
          "docs": "Retrieves a single ordertask. \n\nRequires `ordertask_id`, which can be retrieved via order status retrieval and is\navailable only when order status is `reserved`, `done` or `canceled`.\n"
        }
      ]
    }
  ],
  "bundled": true
}